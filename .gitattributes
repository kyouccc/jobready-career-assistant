# 统一换行符，避免 Windows 下提交导致 shell 脚本在 Linux/macOS 上无法执行
* text=auto

# 强制 LF：跨平台可执行脚本与文本
*.sh    text eol=lf
*.bash  text eol=lf
*.py    text eol=lf
*.md    text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
.gitattributes text eol=lf
.gitignore     text eol=lf
LICENSE        text eol=lf

# 强制 CRLF：仅 Windows 使用的脚本
*.ps1   text eol=crlf
*.bat   text eol=crlf
*.cmd   text eol=crlf

# 二进制文件不做换行符转换
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.zip   binary
*.pdf   binary
